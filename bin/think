#!/usr/bin/env python3
"""Capture a quick thought into the second brain from the terminal.

Usage:
  bin/think "the odrive lock should be enforced at the listener"
  bin/think --topics "odrive-safety" "enforce lock at the listener, not the publisher"
"""
import sys
import argparse
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from secondbrain.query import add_thought


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("text", nargs="+", help="the thought")
    ap.add_argument("--topics", default="", help="comma-separated topic slugs to file under")
    args = ap.parse_args()
    topics = [t.strip() for t in args.topics.split(",") if t.strip()]
    path = add_thought(" ".join(args.text), topics)
    print(path)


if __name__ == "__main__":
    main()
