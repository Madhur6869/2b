#!/usr/bin/env python3
"""Distill conversations into clean structured notes via `claude -p` (subscription).

Usage:
  bin/distill              # distill every conversation not yet distilled
  bin/distill --all        # re-distill ALL conversations (force)
  bin/distill --file PATH   # distill one conversation file
"""
import sys
import argparse
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from secondbrain.distill import distill_all, distill_file


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--all", action="store_true", help="re-distill all (force)")
    ap.add_argument("--file", type=Path, help="distill a single conversation .md")
    args = ap.parse_args()

    if args.file:
        distill_file(args.file)
    else:
        n = distill_all(force=args.all)
        print(f"distilled {n} conversation(s)")


if __name__ == "__main__":
    main()
