#!/usr/bin/env python3
"""Delete audio whose conversation is transcribed, diarized and distilled.

Dry run by default — deleting is irreversible and there is no backup, so you have
to ask for it explicitly.

Usage:
  bin/prune-audio                 # show what would be deleted, delete nothing
  bin/prune-audio --apply         # actually delete
  bin/prune-audio --days 60       # override the configured TTL
  bin/prune-audio --allow-undiarized   # also prune unlabelled transcripts (lossy)
"""
import sys
import argparse
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from secondbrain import config, prune


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--apply", action="store_true", help="actually delete (default: dry run)")
    ap.add_argument("--days", type=int, default=None, help="override ttl_days")
    ap.add_argument(
        "--allow-undiarized",
        action="store_true",
        help="prune even when the transcript has no speaker labels (loses attribution forever)",
    )
    args = ap.parse_args()

    if not config.AUDIO_TTL_ENABLED and args.apply:
        print("[prune] audio_retention.enabled is false in config.yaml — nothing to do.")
        return

    prune.prune(
        dry_run=not args.apply,
        ttl_days=args.days,
        require_diarized=False if args.allow_undiarized else None,
    )


if __name__ == "__main__":
    main()
