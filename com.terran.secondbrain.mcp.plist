<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.terran.secondbrain.mcp</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/madhur/second-brain/.venv/bin/python</string>
    <string>/Users/madhur/second-brain/mcp_server.py</string>
    <string>--http</string>
  </array>
  <!-- One shared MCP server for every Claude session, at http://127.0.0.1:8765/mcp.
       Start at login; relaunch if it exits. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>/Users/madhur/second-brain</string>
  <key>StandardOutPath</key>
  <string>/Users/madhur/second-brain/mcp.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/madhur/second-brain/mcp.log</string>
</dict>
</plist>
